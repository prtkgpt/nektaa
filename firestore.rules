rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/families/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/families/$(request.auth.uid)).data.is_admin == true;
    }

    // Families collection rules
    match /families/{familyId} {
      // Users can read their own family document
      allow read: if isAuthenticated() && request.auth.uid == familyId;

      // Users can create their own family document during registration
      allow create: if isAuthenticated() &&
        request.auth.uid == familyId &&
        request.resource.data.user_id == request.auth.uid;

      // Users can update their own family document
      allow update: if isAuthenticated() && request.auth.uid == familyId;

      // Admins can read all families
      allow read: if isAdmin();

      // Allow system updates (for Stripe webhooks via admin SDK)
      // This is handled server-side with Firebase Admin SDK
    }

    // Donations collection rules
    match /donations/{donationId} {
      // Users can read their own donations
      allow read: if isAuthenticated() &&
        exists(/databases/$(database)/documents/families/$(request.auth.uid)) &&
        resource.data.family_id == request.auth.uid;

      // Admins can read all donations
      allow read: if isAdmin();

      // Only server can create/update donations (via admin SDK for webhooks)
      allow write: if false;
    }
  }
}
